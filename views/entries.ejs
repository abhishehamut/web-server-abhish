<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <title><%= title %></title>
    <link rel="stylesheet" href="/style.css">
    <script src="https://unpkg.com/htmx.org@2.0.4"></script>
  </head>
  <body>
    <%- include('partials/header') %>
    <main>
      <p id="status-announcer" class="sr-only" aria-live="polite"></p>
      <form id="entry-form" class="flex flex-col gap-2 mb-6 sm:flex-row">
        <label for="entry-title" class="sr-only">Title</label>
        <input type="text" id="entry-title" name="title" placeholder="Title"
               title="Shortcut: Alt+Shift+N" class="form-input">
        <label for="entry-body" class="sr-only">Body</label>
        <input type="text" id="entry-body" name="body" placeholder="Body" class="form-input">
        <button type="submit" class="bg-teal-700 text-white rounded px-4 py-2 hover:bg-teal-800">Add entry</button>
      </form>
      <ul id="entries" tabindex="-1">
        <% entries.forEach((entry) => { %>
          <li data-id="<%= entry.id %>" data-title="<%= entry.title %>" data-body="<%= entry.body %>" data-favorite="<%= entry.favorite %>">
            <span class="entry-display"><strong><%= entry.title %>:</strong> <%= entry.body %></span>
            <button
              class="favorite-btn"
              type="button"
              aria-label="<%= entry.favorite ? 'Remove from favorites' : 'Add to favorites' %>"
            ><%= entry.favorite ? '★' : '☆' %></button>
            <button class="edit-btn hover:bg-teal-50" type="button">Edit</button>
            <button
              class="delete-btn hover:bg-red-50"
              hx-delete="/entries/<%= entry.id %>"
              hx-target="closest li"
              hx-swap="outerHTML"
              hx-confirm="Delete this entry?"
              hx-indicator="next .delete-indicator"
            >Delete</button>
            <span class="delete-indicator htmx-indicator">Deleting...</span>
          </li>
        <% }); %>
      </ul>

      <section class="classic-form">
        <h2>Classic form (no JavaScript)</h2>
        <form method="POST" action="/entries/classic">
          <label for="classic-title" class="sr-only">Title</label>
          <input type="text" id="classic-title" name="title" placeholder="Title">
          <label for="classic-body" class="sr-only">Body</label>
          <input type="text" id="classic-body" name="body" placeholder="Body">
          <button type="submit">Add entry the classic way</button>
        </form>
      </section>
    </main>
    <script src="/app.js" defer></script>
  </body>
</html>